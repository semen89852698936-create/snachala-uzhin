      "title": "Чуррос с горячим шоколадом",
      "original_name": "Churros con chocolate",
      "servings": 2,
      "total_min": 35,
      "ingredients": [
        {
          "name": "Пшеничная мука",
          "amount": 150,
          "unit": "г"
