      "title": "Японский завтрак с жареным лососем",
      "original_name": "Shake no shioyaki teishoku",
      "servings": 2,
      "total_min": 40,
      "ingredients": [
        {
          "name": "Филе лосося без костей",
          "amount": 260,
          "unit": "г"
        },
        {
          "name": "Рис японский сухой",
          "amount": 140,
          "unit": "г"
