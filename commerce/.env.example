# Configure in Timeweb Cloud secret environment ONLY. Never commit real credentials.
COMMERCE_BASE_URL=https://your-commercial-domain.example
COMMERCE_DB_PATH=/srv/data/orders.sqlite
# openssl rand -hex 32 (do NOT paste the result into GitHub or chat)
SESSION_KEY_HEX=REPLACE_IN_HOST_SECRET_STORE
PRIVATE_CATALOG_HTML=/srv/private/app.html
# Leave checkout OFF until Prodamus confirmed, DB persistent, email verified, and access QA complete.
ENABLE_CHECKOUT=0
PRODAMUS_URL=https://YOUR_ASSIGNED_PAGE.payform.ru/
# Unique integration sys must be agreed with Prodamus support.
PRODAMUS_SYS=NOT_CONFIGURED
PRODAMUS_SECRET=REPLACE_IN_HOST_SECRET_STORE
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
SMTP_SENDER=
